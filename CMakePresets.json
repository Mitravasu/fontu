{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "release-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": { "BUILD_TESTING": "ON", "CMAKE_BUILD_TYPE": "Release" }
    },
    { "name": "release-unix", "inherits": "release-base", "generator": "Unix Makefiles" },
    { "name": "release-macos", "inherits": "release-unix", "cacheVariables": { "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0" } },
    {
      "name": "release-windows",
      "inherits": "release-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    }
  ],
  "buildPresets": [
    { "name": "release-unix", "configurePreset": "release-unix", "configuration": "Release" },
    { "name": "release-macos", "configurePreset": "release-macos", "configuration": "Release" },
    { "name": "release-windows", "configurePreset": "release-windows", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "release-unix", "configurePreset": "release-unix", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "timeout": 120 } },
    { "name": "release-macos", "configurePreset": "release-macos", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "timeout": 120 } },
    { "name": "release-windows", "configurePreset": "release-windows", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "timeout": 120 } }
  ]
}
